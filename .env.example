# --- OpenAI (human seller brain + web market research) ---
# Required for Live LLM badge + conversational seller.
# Also powers Responses/web-search market quotes when SERPER/BRAVE/TAVILY unset.
# Leave empty → Rules mode (heuristic quote fallback; prefer setting a search key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional dedicated search model fallback for Chat Completions web search:
# OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview

# --- Optional dedicated web search (first match wins) ---
# SERPER_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Chat spend guards (server-side; defaults shown)
# CHAT_RATE_LIMIT_PER_MIN=20
# CHAT_MAX_TURNS_PER_DAY=200
# CHAT_MAX_TOKENS_PER_DAY=100000

# --- Suby crypto checkout ---
# Published/production: leave SUBY_MOCK=false and set SUBY_API_KEY for real checkout.
# Local development defaults to mock when SUBY_MOCK is unset.
SUBY_API_KEY=
SUBY_MOCK=false
# Required for /api/payments/webhook. Use a long random value; never ship a default.
SUBY_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Operator alerts (stubs → console / data/store.json when unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Admin ---
# Required for /admin and /api/admin/orders (header x-admin-key only).
ADMIN_KEY=
