# --- OpenAI (human seller brain) ---
# Required for Live LLM badge + conversational seller.
# Leave empty → Rules mode (still quotes via pricing.ts).
# On Windows (cmd):
#   copy .env.example .env.local
#   notepad .env.local
# Then set OPENAI_API_KEY=sk-... (no quotes needed), save, restart npm run dev.
# Check: GET http://localhost:3000/api/chat/status → { "mode":"llm", "hasKey":true }
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Suby crypto checkout (mocked when key empty or SUBY_MOCK=true) ---
SUBY_API_KEY=
SUBY_MOCK=true
# Required for /api/payments/webhook. Use a long random value; never ship a default.
SUBY_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Operator alerts (stubs → console / data/store.json when unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Admin ---
# Required for /admin and /api/admin/orders (query ?key= or header x-admin-key).
# Use a long random value; leave empty to disable admin until set.
ADMIN_KEY=
