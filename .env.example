# --- OpenAI (seller brain + forced ChatGPT web search for quotes) ---
# Required for Live LLM + Responses API web_search on every market quote.
# Leave empty → Rules mode (optional Serper/Brave/Tavily, else heuristic).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional Chat Completions search-model fallback if Responses web_search fails:
# OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview

# --- Optional dedicated web search (used only if OpenAI key unset / OpenAI search fails) ---
# SERPER_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Chat spend guards (server-side; defaults shown)
# CHAT_RATE_LIMIT_PER_MIN=20
# CHAT_MAX_TURNS_PER_DAY=200
# CHAT_MAX_TOKENS_PER_DAY=100000

# --- Suby crypto checkout ---
# Published/production: leave SUBY_MOCK=false and set SUBY_API_KEY for real checkout.
# Local development defaults to mock when SUBY_MOCK is unset.
# Published Cursor hosts ignore mock unless SUBY_MOCK=true (mock-complete still needs admin).
SUBY_API_KEY=
SUBY_MOCK=false
# Optional checkout spend guards (defaults shown)
# CHECKOUT_RATE_PER_HOUR=5
# CHECKOUT_MAX_SPEND_PER_DAY=2000
# Required for /api/payments/webhook. Use a long random value; never ship a default.
SUBY_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Operator alerts (stubs → console / data/store.json when unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Admin ---
# Required for /admin and /api/admin/orders (header x-admin-key only).
ADMIN_KEY=
